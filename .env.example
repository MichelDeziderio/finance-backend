PORT=3000
MONGODB_URI=mongodb://localhost:27017/finance
FRONTEND_ORIGIN=http://localhost:4200
FRONTEND_URL=http://localhost:4200

# JWT Authentication
JWT_SECRET=sua_chave_secreta_jwt_super_segura
JWT_EXPIRES_IN=7d

# E-mail (SMTP Gmail)
# Dica: No Gmail, utilize uma "Senha de App" (App Password) gerada em sua conta Google
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_SECURE=false
MAIL_USER=seu-email@gmail.com
MAIL_PASS=sua-senha-de-app-de-16-digitos
MAIL_FROM="Finan$e <seu-email@gmail.com>"

